---
import { business } from "../data/facts";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";
---

<section class="contact" id="contact">
  <div class="container contact-inner">
    <p class="eyebrow" data-reveal>{isAr ? "تواصل معنا" : "Get in touch"}</p>
    <h2 class="h-section" data-reveal>
      {isAr ? "لديكم مشروع؟ لنصنع أثاثه معًا." : "Have a project? Let's build the furniture for it."}
    </h2>
    <p class="contact-sub" data-reveal>
      {isAr
        ? "راسلونا على إنستغرام لطلبات الجملة والتعاقدات، أو زوروا موقعنا لمزيد من التفاصيل."
        : "Message us on Instagram for bulk and contract orders, or visit our website for more detail."}
    </p>
    <div class="contact-actions" data-reveal>
      <a class="btn btn-primary" data-magnetic href={business.instagram} target="_blank" rel="noopener">
        {isAr ? "راسلونا على إنستغرام" : "Message us on Instagram"}
      </a>
      <a class="btn btn-outline" data-magnetic href={business.website} target="_blank" rel="noopener">
        {isAr ? "زيارة موقعنا" : "Visit our site"}
      </a>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--surface);
  }

  .contact-inner {
    max-width: 62ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-sub {
    font-weight: 300;
    color: color-mix(in srgb, var(--text) 70%, transparent);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".contact-inner", () => {
    animate(
      ".contact-inner [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 18, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.1), easing: "ease-out" }
    );
  });

  const hasFinePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  if (hasFinePointer && !reduceMotion) {
    document.querySelectorAll<HTMLElement>(".contact [data-magnetic]").forEach((el) => {
      el.addEventListener("mousemove", (e) => {
        const rect = el.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        animate(el, { x: x * 0.25, y: y * 0.35 }, { duration: 0.3, easing: "ease-out" });
      });
      el.addEventListener("mouseleave", () => {
        animate(el, { x: 0, y: 0 }, { duration: 0.4, easing: "ease-out" });
      });
    });
  }
</script>
