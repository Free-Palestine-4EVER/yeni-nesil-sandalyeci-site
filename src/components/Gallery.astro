---
import { Image } from "astro:assets";
import { feedPosts } from "../data/photos";
import { business } from "../data/facts";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";

const bigCells = new Set([4, 7, 8, 11]);
---

<section class="gallery" id="gallery">
  <div class="container gallery-head">
    <p class="eyebrow" data-reveal>{isAr ? "من إنستغرام" : "From the feed"}</p>
    <h2 class="h-section" data-reveal>
      {isAr ? "أعمال حقيقية، مشاريع حقيقية" : "Real projects, straight from Instagram"}
    </h2>
    <a class="btn btn-primary" data-magnetic href={business.instagram} target="_blank" rel="noopener" data-reveal>
      {isAr ? "تابعنا على إنستغرام" : "Follow on Instagram"}
    </a>
  </div>

  <div class="bento container">
    {feedPosts.map((post, i) => (
      <button
        type="button"
        class:list={["tile", { big: bigCells.has(i) }]}
        data-tile
        data-index={i}
        aria-label={isAr ? "فتح الصورة" : "Open photo"}
      >
        <Image src={post.image} alt={post.alt} width={bigCells.has(i) ? 900 : 600} height={bigCells.has(i) ? 900 : 750} loading="lazy" format="webp" />
        {post.isVideo && <span class="video-badge" aria-hidden="true">▶</span>}
        <span class="tile-scrim"></span>
        <span class="tile-caption">{isAr ? post.captionAr : post.caption}</span>
      </button>
    ))}
  </div>
</section>

<div class="lightbox" data-lightbox hidden>
  <button class="lightbox-close" type="button" data-lightbox-close aria-label={isAr ? "إغلاق" : "Close"}>×</button>
  <div class="lightbox-inner">
    <img data-lightbox-img alt="" />
    <p data-lightbox-caption></p>
    <a data-lightbox-link href="#" target="_blank" rel="noopener" class="btn btn-outline">
      {isAr ? "شاهد المنشور على إنستغرام" : "View post on Instagram"}
    </a>
  </div>
</div>

<script define:vars={{ posts: feedPosts.map((p) => ({ caption: p.caption, captionAr: p.captionAr, permalink: p.permalink })), isAr }}>
  window.__galleryPosts = posts;
  window.__galleryIsAr = isAr;
</script>

<style>
  .gallery {
    padding-block: clamp(4rem, 7vw, 7rem);
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .gallery-head h2 {
    flex: 1 1 40ch;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.6rem, 1.2vw, 1rem);
  }

  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .tile {
    position: relative;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }

  .tile.big {
    grid-column: span 2;
    grid-row: span 2;
    aspect-ratio: 1;
  }

  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .tile:hover :global(img) {
    transform: scale(1.06);
  }

  .video-badge {
    position: absolute;
    top: 0.6rem;
    inset-inline-end: 0.6rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent-2) 70%, transparent);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
  }

  .tile-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(28, 27, 25, 0.85) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .tile-caption {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.6rem;
    color: #fff;
    font-size: var(--step-small);
    text-align: start;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .tile:hover .tile-scrim,
  .tile:focus-visible .tile-scrim {
    opacity: 1;
  }

  .tile:hover .tile-caption,
  .tile:focus-visible .tile-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(28, 27, 25, 0.92);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-inner {
    max-width: min(640px, 90vw);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
  }

  .lightbox-inner img {
    max-height: 60vh;
    border-radius: 12px;
    object-fit: contain;
  }

  .lightbox-inner p {
    color: var(--bg);
    font-size: var(--step-small);
  }

  .lightbox-close {
    position: absolute;
    top: 1.25rem;
    inset-inline-end: 1.5rem;
    background: none;
    border: none;
    color: var(--bg);
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".gallery-head", () => {
    animate(
      ".gallery-head [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 18, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.1), easing: "ease-out" }
    );
  });

  inView(".bento", () => {
    animate(
      ".bento .tile",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 30, 0], scale: [0.94, 1] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.02 : 0.06), easing: "ease-out" }
    );
  });

  type GalleryPost = { caption: string; captionAr: string; permalink: string };
  const posts: GalleryPost[] = (window as any).__galleryPosts || [];
  const isAr: boolean = (window as any).__galleryIsAr;

  const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
  const lightboxImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
  const lightboxCaption = document.querySelector<HTMLElement>("[data-lightbox-caption]");
  const lightboxLink = document.querySelector<HTMLAnchorElement>("[data-lightbox-link]");

  document.querySelectorAll<HTMLButtonElement>("[data-tile]").forEach((tile) => {
    tile.addEventListener("click", () => {
      const index = Number(tile.dataset.index);
      const post = posts[index];
      const img = tile.querySelector("img");
      if (!post || !lightbox || !lightboxImg || !lightboxCaption || !lightboxLink || !img) return;
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = isAr ? post.captionAr : post.caption;
      lightboxLink.href = post.permalink;
      lightbox.hidden = false;
    });
  });

  document.querySelector("[data-lightbox-close]")?.addEventListener("click", () => {
    if (lightbox) lightbox.hidden = true;
  });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) lightbox.hidden = true;
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && lightbox) lightbox.hidden = true;
  });
</script>
