---
import { Image } from "astro:assets";
import { photos } from "../data/photos";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";
---

<section class="spotlight" id="spotlight">
  <div class="spotlight-media" data-wipe>
    <Image
      src={photos.post04}
      alt={isAr ? "كرسي بار LEO المخصص بتفاصيله الجريئة المصنوعة يدويًا" : "The LEO custom bar chair, showing its bold hand-crafted detail"}
      width={1600}
      height={1000}
      loading="lazy"
      format="webp"
    />
    <div class="spotlight-scrim"></div>
  </div>
  <div class="container spotlight-copy">
    <p class="eyebrow" data-reveal>{isAr ? "قطعة مميزة" : "Featured piece"}</p>
    <h2 class="h-section" data-reveal>LEO</h2>
    <p class="spotlight-text" data-reveal>
      {isAr
        ? "قوة في كل تفصيل. خطوط جريئة، صناعة يدوية، وشخصية أصيلة — LEO ليس مجرد كرسي بار، بل صُمم ليكون محور الاهتمام في المكان الذي يوضع فيه."
        : "Power in every detail. Bold lines, hand craftsmanship and genuine character — LEO isn't just a bar chair, it's designed to be the focal point of the room it sits in."}
    </p>
  </div>
</section>

<style>
  .spotlight {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: flex-end;
    color: var(--bg);
    overflow: hidden;
  }

  .spotlight-media {
    position: absolute;
    inset: 0;
  }

  .spotlight-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .spotlight-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(28, 27, 25, 0.92) 5%, rgba(28, 27, 25, 0.25) 55%, rgba(28, 27, 25, 0.55) 100%);
  }

  .spotlight-copy {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    max-width: 60ch;
  }

  .spotlight-copy .h-section {
    font-size: clamp(3rem, 8vw, 7rem);
    color: var(--accent);
    font-weight: 900;
  }

  .spotlight-text {
    font-size: var(--step-body);
    font-weight: 300;
    color: color-mix(in srgb, var(--bg) 88%, transparent);
    margin-top: 0.75rem;
  }
</style>

<script>
  import { animate, inView, scroll, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const media = document.querySelector<HTMLElement>("[data-wipe]");
  if (media) {
    if (reduceMotion) {
      media.style.clipPath = "inset(0 0 0 0)";
    } else {
      inView(
        media,
        () => {
          animate(media, { clipPath: ["inset(0 100% 0 0)", "inset(0 0% 0 0)"] }, { duration: 1.1, easing: [0.65, 0, 0.35, 1] });
        },
        { margin: "-15% 0px -15% 0px" }
      );
    }

    scroll(animate(media.querySelector("img"), { scale: [1, 1.12] }), {
      target: media,
      offset: ["start end", "end start"],
    });
  }

  inView(".spotlight-copy", () => {
    animate(
      ".spotlight-copy [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 22, 0] },
      { duration: reduceMotion ? 0.25 : 0.65, delay: stagger(reduceMotion ? 0.03 : 0.12), easing: "ease-out" }
    );
  });
</script>
