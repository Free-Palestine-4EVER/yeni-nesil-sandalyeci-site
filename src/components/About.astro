---
import { Image } from "astro:assets";
import { photos } from "../data/photos";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";
---

<section class="about" id="about">
  <div class="about-photo" data-reveal>
    <Image
      src={photos.post08}
      alt={isAr ? "كراسي جلدية بنية بإطار كروم ومسند ظهر من الخيزران على خلفية استوديو نظيفة" : "Brown leather cantilever chairs with chrome frames and cane backrests on a clean studio background"}
      width={1400}
      height={1750}
      loading="lazy"
      format="webp"
    />
  </div>
  <div class="about-copy">
    <p class="eyebrow" data-reveal>{isAr ? "قصتنا" : "About us"}</p>
    <blockquote class="pull-quote" data-reveal>
      {isAr
        ? "مصنّعون تعاقديون للأثاث — نصمّم وننتج الكراسي والطاولات والمقاعد للمقاهي والمطاعم والفنادق، من المواد الخام إلى القطعة النهائية المسلَّمة."
        : "Contract furniture manufacturer — we design and produce chairs, tables and stools for cafés, restaurants and hotels, from raw material to the finished, delivered piece."}
    </blockquote>
    <p class="about-detail" data-reveal>
      {isAr
        ? "المصنع والصالة: حي الشريفلي، شارع طورغوت أوزال، 199/5، أُمرانيه، إسطنبول."
        : "Factory & showroom: Şerifali Mahallesi, Turgut Özal Bulvarı, 199/5, Ümraniye, İstanbul."}
    </p>
  </div>
</section>

<style>
  .about {
    display: grid;
    background: var(--surface);
  }

  @media (min-width: 860px) {
    .about {
      grid-template-columns: 0.85fr 1.15fr;
      min-height: 70vh;
    }
  }

  .about-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  @media (min-width: 860px) {
    .about-photo {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .about-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.75rem;
    max-width: 52ch;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem);
  }

  .pull-quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 700;
    line-height: 1.18;
  }

  [dir="rtl"] .pull-quote {
    font-family: var(--font-ar);
  }

  .about-detail {
    font-size: var(--step-small);
    color: color-mix(in srgb, var(--text) 65%, transparent);
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".about", () => {
    animate(
      ".about [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 20, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.1), easing: "ease-out" }
    );
  });
</script>
