---
import { Image } from "astro:assets";
import { photos } from "../data/photos";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";
---

<section class="about" id="about">
  <div class="about-grid container">
    <div class="about-portrait" data-reveal>
      <Image
        src={photos.profile}
        alt={isAr ? "الصورة الرمزية لحساب ييني نسل صندلیجي على إنستغرام" : "YENİ NESİL SANDALYECİ's Instagram profile portrait"}
        width={480}
        height={480}
        loading="lazy"
        format="webp"
      />
    </div>
    <div class="about-copy">
      <p class="eyebrow" data-reveal>{isAr ? "قصتنا" : "About us"}</p>
      <blockquote class="pull-quote" data-reveal>
        {isAr ? (
          <>
            <span class="drop-cap">م</span>صنّعون تعاقديون للأثاث — نصمّم وننتج الكراسي والطاولات والمقاعد للمقاهي والمطاعم والفنادق، من المواد الخام إلى القطعة النهائية المسلَّمة.
          </>
        ) : (
          <>
            <span class="drop-cap">C</span>ontract furniture manufacturer — we design and produce chairs, tables and stools for cafés, restaurants and hotels, from raw material to the finished, delivered piece.
          </>
        )}
      </blockquote>
      <p class="about-detail" data-reveal>
        {isAr
          ? "المصنع والصالة: حي الشريفلي، شارع طورغوت أوزال، 199/5، أُمرانيه، إسطنبول."
          : "Factory & showroom: Şerifali Mahallesi, Turgut Özal Bulvarı, 199/5, Ümraniye, İstanbul."}
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4rem, 7vw, 7rem);
  }

  .about-grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 0.8fr 1.2fr;
    }
  }

  .about-portrait :global(img) {
    border-radius: 50%;
    aspect-ratio: 1;
    object-fit: cover;
    width: min(280px, 60vw);
    box-shadow: 0 20px 60px -20px rgba(42, 35, 32, 0.35);
  }

  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 56ch;
  }

  .pull-quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 700;
    line-height: 1.2;
  }

  [dir="rtl"] .pull-quote {
    font-family: var(--font-ar);
  }

  .drop-cap {
    float: inline-start;
    font-size: 2.2em;
    line-height: 0.8;
    padding-inline-end: 0.08em;
    color: var(--accent);
    font-weight: 900;
  }

  .about-detail {
    font-size: var(--step-small);
    color: color-mix(in srgb, var(--text) 65%, transparent);
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".about", () => {
    animate(
      ".about [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 20, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.1), easing: "ease-out" }
    );
  });
</script>
