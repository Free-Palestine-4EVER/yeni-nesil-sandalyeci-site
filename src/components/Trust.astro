---
import { business } from "../data/facts";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";

const stats = [
  {
    value: business.followers,
    en: "followers on Instagram",
    ar: "متابع على إنستغرام",
  },
  {
    value: business.postCount,
    en: "projects & posts shared",
    ar: "مشروع ومنشور تمت مشاركته",
  },
];

const prideLines = isAr
  ? [
      "تصنيع مخصص — كل قطعة تُصنع حسب طلب المكان، وليست جاهزة من المستودع.",
      "موثوقون من مقاهي ومطاعم وفنادق إسطنبول لطلبات الجملة والتعاقدات.",
      "تصميم وإنتاج داخلي بالكامل، من المادة الخام إلى القطعة المسلَّمة.",
    ]
  : [
      "Custom manufacturing — every piece is built to the venue's own brief, not off-the-shelf.",
      "Trusted by cafés, restaurants and hotels across İstanbul for corporate and bulk orders.",
      "In-house design and production, from raw material to finished, delivered piece.",
    ];
---

<section class="trust" id="trust">
  <div class="container trust-inner">
    <p class="trust-lede" data-reveal>
      {isAr ? (
        <>
          أكثر من <span class="trust-num" data-count-to={stats[0].value}>0</span> يتابعون العمل الخارج من هذا المصنع
          على إنستغرام{business.isVerified ? " — حساب موثّق" : ""}، وأكثر من{" "}
          <span class="trust-num" data-count-to={stats[1].value}>0</span> مشروع وقطعة تمت مشاركتها حتى الآن.
        </>
      ) : (
        <>
          Over <span class="trust-num" data-count-to={stats[0].value}>0</span> people follow the work coming out of
          this factory on Instagram{business.isVerified ? " — a verified account" : ""}, and more than{" "}
          <span class="trust-num" data-count-to={stats[1].value}>0</span> projects and pieces shared so far.
        </>
      )}
    </p>
    <ul class="pride">
      {prideLines.map((line) => (
        <li data-reveal>{line}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(4rem, 7vw, 7rem);
    background: var(--accent-2);
    color: var(--bg);
  }

  .trust-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  .trust-lede {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-h2);
    line-height: 1.25;
    max-width: 34ch;
  }

  [dir="rtl"] .trust-lede {
    font-family: var(--font-ar);
    max-width: 28ch;
  }

  .trust-num {
    font-weight: 900;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .pride {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (min-width: 720px) {
    .pride {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pride li {
    position: relative;
    font-weight: 300;
    font-size: var(--step-body);
    color: color-mix(in srgb, var(--bg) 90%, transparent);
    padding-top: 1.1rem;
  }

  .pride li::before {
    content: "";
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 2.5rem;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".trust-inner", () => {
    animate(
      ".trust [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 18, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.08), easing: "ease-out" }
    );

    document.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => {
      const target = Number(el.dataset.countTo || 0);
      const counter = { value: 0 };
      animate(counter, { value: target }, {
        duration: reduceMotion ? 0.25 : 1.6,
        easing: "ease-out",
        onUpdate: (latest) => {
          // Motion's onUpdate for a plain-object animation hands back the
          // raw interpolated number itself, not a {value: number} wrapper —
          // reading latest.value here was always undefined (NaN once
          // rounded). This exact wrong-return-value assumption is called
          // out in the build prompt now specifically because of this bug.
          el.textContent = Math.round(latest).toLocaleString("en-US") + "+";
        },
      });
    });
  });
</script>
