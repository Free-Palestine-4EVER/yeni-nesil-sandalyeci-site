---
import { business } from "../data/facts";

interface Props {
  lang: "en" | "ar";
}
const { lang } = Astro.props as Props;
const isAr = lang === "ar";

const stats = [
  {
    value: business.followers,
    en: "followers on Instagram",
    ar: "متابع على إنستغرام",
  },
  {
    value: business.postCount,
    en: "projects & posts shared",
    ar: "مشروع ومنشور تمت مشاركته",
  },
];

const prideLines = isAr
  ? [
      "تصنيع مخصص — كل قطعة تُصنع حسب طلب المكان، وليست جاهزة من المستودع.",
      "موثوقون من مقاهي ومطاعم وفنادق إسطنبول لطلبات الجملة والتعاقدات.",
      "تصميم وإنتاج داخلي بالكامل، من المادة الخام إلى القطعة المسلَّمة.",
    ]
  : [
      "Custom manufacturing — every piece is built to the venue's own brief, not off-the-shelf.",
      "Trusted by cafés, restaurants and hotels across İstanbul for corporate and bulk orders.",
      "In-house design and production, from raw material to finished, delivered piece.",
    ];
---

<section class="trust" id="trust">
  <div class="container trust-grid">
    <div class="stats">
      {stats.map((s) => (
        <div class="stat" data-reveal>
          <span class="stat-num" data-count-to={s.value}>0</span>
          <span class="stat-label">{isAr ? s.ar : s.en}</span>
        </div>
      ))}
      {business.isVerified && (
        <div class="stat verified" data-reveal>
          <span class="badge">✓</span>
          <span class="stat-label">{isAr ? "حساب إنستغرام موثّق" : "Verified Instagram account"}</span>
        </div>
      )}
    </div>
    <ul class="pride">
      {prideLines.map((line) => (
        <li data-reveal>{line}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: clamp(4rem, 7vw, 7rem);
    background: var(--accent-2);
    color: var(--bg);
  }

  .trust-grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 860px) {
    .trust-grid {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-num {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: var(--step-small);
    color: color-mix(in srgb, var(--bg) 75%, transparent);
    max-width: 20ch;
  }

  .verified {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-2);
    font-weight: 900;
  }

  .pride {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: 1.25rem;
  }

  .pride li {
    font-weight: 300;
    font-size: var(--step-body);
    color: color-mix(in srgb, var(--bg) 90%, transparent);
  }
</style>

<script>
  import { animate, inView, stagger } from "motion";

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  inView(".trust-grid", () => {
    animate(
      ".trust [data-reveal]",
      { opacity: [0, 1], y: [reduceMotion ? 6 : 18, 0] },
      { duration: reduceMotion ? 0.25 : 0.6, delay: stagger(reduceMotion ? 0.03 : 0.08), easing: "ease-out" }
    );

    document.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => {
      const target = Number(el.dataset.countTo || 0);
      const counter = { value: 0 };
      animate(counter, { value: target }, {
        duration: reduceMotion ? 0.25 : 1.6,
        easing: "ease-out",
        onUpdate: (latest) => {
          el.textContent = Math.round(latest.value).toLocaleString("en-US") + "+";
        },
      });
    });
  });
</script>
